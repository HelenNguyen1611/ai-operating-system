<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent template — auto-start MCP gateway + cloudflared at login.

  Install:
    1. Edit paths below if your repo lives elsewhere.
    2. cp com.personal-ai-os.mcp-stack.plist.example ~/Library/LaunchAgents/com.personal-ai-os.mcp-stack.plist
    3. launchctl load ~/Library/LaunchAgents/com.personal-ai-os.mcp-stack.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.personal-ai-os.mcp-stack.plist
    rm ~/Library/LaunchAgents/com.personal-ai-os.mcp-stack.plist

  Note: Quick Tunnel URL changes on each cloudflared restart — update Claude MCP connector after login.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.personal-ai-os.mcp-stack</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/admin/Documents/Projects/AI/Personal-AI-Operating-System/apps/mcp-gateway/scripts/start-stack.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/admin/Documents/Projects/AI/Personal-AI-Operating-System/apps/mcp-gateway</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/admin/Documents/Projects/AI/Personal-AI-Operating-System/apps/mcp-gateway/.run/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/admin/Documents/Projects/AI/Personal-AI-Operating-System/apps/mcp-gateway/.run/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
